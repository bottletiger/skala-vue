# Supabase Edge Function 전용 값입니다. 실제 값은 supabase/.env.local에만 저장하세요.
OPENAI_API_KEY=sk-replace-me
# 선택: primary가 credit_balance_exhausted일 때만 동일 요청을 1회 재전송합니다.
# OPENAI_API_KEY_SECONDARY=sk-replace-me
# 기존 환경명 BACKUP_OPENAI_API_KEY도 같은 용도로 인식합니다.
OPENAI_MODEL=gpt-5.6
# 선택: OpenAI 잔액/쿼터 소진 시 사용하는 Gemini API 키입니다.
# GEMINI_KEY=AIza-replace-me
# 기본 모델은 gemini-3.1-flash-lite이며, 프로젝트에서 허용된 모델로 바꿀 수 있습니다.
# GEMINI_MODEL=gemini-3.1-flash-lite
# 필수: 비어 있으면 Origin이 있는 모든 브라우저 요청을 거부합니다.
# localhost도 개발 중 사용할 origin을 정확히 적어야 합니다.
ALLOWED_ORIGINS=http://localhost:3000,https://kngyeol.github.io
