# 이 파일을 .env.local로 복사하고 Supabase의 공개 클라이언트 값만 입력하세요.
# publishable key는 RLS와 함께 브라우저에서 사용하는 값입니다.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_GOOGLE_AUTH_ENABLED=false

# OPENAI_API_KEY, OPENAI_MODEL, Supabase secret/service-role key는
# Vite 환경변수에 넣지 말고 Supabase Edge Function secret으로 설정하세요.
